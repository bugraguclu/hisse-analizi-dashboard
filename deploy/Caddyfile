# Production front proxy. Terminates TLS (automatic HTTPS via Let's Encrypt)
# and forwards everything to the "dashboard" service on the compose network.
#
# Required: DOMAIN (e.g. hisse.example.com) and ACME_EMAIL (Let's Encrypt
# contact address for expiry/problem notices). Both are enforced by
# docker-compose.prod.yml — an empty ACME_EMAIL would leave the global
# `email` option without an argument and Caddy would refuse the config.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Security headers Next.js does not already set itself (see
	# dashboard/next.config.ts for X-Content-Type-Options / X-Frame-Options /
	# Referrer-Policy / Permissions-Policy). Next.js *does* also send its own
	# Strict-Transport-Security in production builds (without includeSubDomains);
	# the `>` prefix defers this write until the response is sent to the client,
	# so ours overrides theirs instead of losing to it — see
	# https://caddyserver.com/docs/caddyfile/directives/header ("override the
	# ... header that a proxy upstream had set" requires the `>` prefix).
	header {
		>Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	encode zstd gzip

	reverse_proxy dashboard:3000 {
		transport http {
			dial_timeout  5s
			read_timeout  60s
			write_timeout 60s
		}
	}
}
