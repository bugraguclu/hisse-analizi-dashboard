# Production front proxy. Terminates TLS (automatic HTTPS via Let's Encrypt)
# and forwards everything to the "dashboard" service on the compose network.
#
# Required: DOMAIN (e.g. hisse.example.com), enforced by docker-compose.prod.yml.
# The ACME account is registered without a contact address: Let's Encrypt no
# longer sends expiry e-mails and Caddy renews certificates on its own.

{$DOMAIN} {
	# Security headers Next.js does not already set itself (see
	# dashboard/next.config.ts for X-Content-Type-Options / X-Frame-Options /
	# Referrer-Policy / Permissions-Policy). Next.js *does* also send its own
	# Strict-Transport-Security in production builds (without includeSubDomains);
	# the `>` prefix defers this write until the response is sent to the client,
	# so ours overrides theirs instead of losing to it — see
	# https://caddyserver.com/docs/caddyfile/directives/header ("override the
	# ... header that a proxy upstream had set" requires the `>` prefix).
	header {
		>Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Service worker (dashboard/src/app/sw.js): root scope and never cached by the
	# browser's HTTP cache, so a deployment reaches already-open tabs. `>` again
	# overrides whatever the upstream sent.
	@serviceWorker path /sw.js
	header @serviceWorker {
		>Cache-Control "no-cache, no-store, must-revalidate"
		>Service-Worker-Allowed "/"
	}

	# Web app manifest: short cache, icons/name changes should land within an hour.
	@manifest path /manifest.webmanifest
	header @manifest >Cache-Control "public, max-age=3600"

	encode zstd gzip

	reverse_proxy dashboard:3000 {
		transport http {
			dial_timeout  5s
			read_timeout  60s
			write_timeout 60s
		}
	}
}
