# Next.js server -> FastAPI. This value is not exposed to the browser.
API_URL=http://localhost:8000

# Optional: use only when the browser must call a separately hosted API directly.
# NEXT_PUBLIC_API_URL=https://api.example.com

# Number of reverse proxies in front of Next.js (default 0). With 0 and Next
# exposed directly, clients can spoof X-Forwarded-For. In docker-compose.prod.yml
# Caddy sits in front and replaces X-Forwarded-For from untrusted clients with
# the real client IP, so that setup sets this to 1.
# TRUSTED_PROXY_HOPS=0
