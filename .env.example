# Copy to .env and fill in secrets. Defaults below match docker-compose.yml
# and src/core/config.py — `docker compose up` works out of the box with
# this file copied verbatim.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
TZ=Europe/Istanbul

# --- Database ---
# Used directly when running the API/worker outside Docker (.venv). Inside
# docker-compose.yml, app/worker/migrate override these to point at the
# "db" service host instead — see the DATABASE_URL(_SYNC) lines there.
DATABASE_URL=postgresql+asyncpg://hisse:hisse@localhost:5432/hisse_analizi
DATABASE_URL_SYNC=postgresql://hisse:hisse@localhost:5432/hisse_analizi
# Log every SQL statement — very noisy, debugging only.
DB_ECHO=false
# Read by docker-compose.yml to create the "db" container; keep in sync with
# the URLs above when changed.
POSTGRES_USER=hisse
POSTGRES_PASSWORD=hisse
POSTGRES_DB=hisse_analizi

# --- Worker polling ---
DEFAULT_POLL_INTERVAL_SECONDS=30
USER_AGENT=HisseAnalizi/1.0
WORKER_MAX_CONCURRENCY=5
WORKER_SINGLE_REPLICA=true
# Fits Docker's default 10s "stop" grace period.
WORKER_SHUTDOWN_TIMEOUT_SECONDS=8.0

# --- HTTP client (src/adapters/utils.py shared httpx client) ---
HTTP_CONNECT_TIMEOUT=15.0
HTTP_READ_TIMEOUT=30.0

# --- Upstream failure backoff (adapter polling loops and outbox retries) ---
BACKOFF_BASE_SECONDS=60
BACKOFF_MAX_SECONDS=900
BACKOFF_FACTOR=2
MAX_CONSECUTIVE_FAILURES=5

# --- Outbox / notifications ---
OUTBOX_BATCH_SIZE=10
# After this many failed attempts an outbox entry is marked status=failed.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=30
# Events older than this are not e-mailed (avoids spamming after backfills/outages).
NOTIFICATION_MAX_EVENT_AGE_HOURS=48

# --- Admin & security ---
# Admin API key — required in production, optional in dev (all admin calls
# bypass auth in dev if unset)
ADMIN_API_KEY=
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Reverse-proxy / load-balancer addresses trusted to set X-Forwarded-* headers
# for client-IP-based rate limiting (comma-separated IPs or CIDR ranges).
# Defaults cover loopback + private RFC1918 ranges (Docker bridge networks).
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- Rate limiting ---
# The dashboard UI makes ~20 API calls per page load; 300/minute is the
# site-wide default per client IP (see TRUSTED_PROXIES above).
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_ADMIN=20/minute

# --- Haber toplama (Faz 2) — Google News RSS, 15 dk'da bir BIST 100 taramasi ---
NEWS_POLL_ENABLED=true
NEWS_POLL_INTERVAL_SECONDS=900
NEWS_FETCH_CONCURRENCY=4

# --- SMTP (optional — dry-run if not configured) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Port 465 -> implicit TLS, any other port -> STARTTLS.
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30.0
ENABLE_REAL_EMAIL=false

# --- Production front proxy (Caddy, docker-compose.prod.yml only) ---
# Public hostname Caddy requests a Let's Encrypt certificate for. Required
# when using the prod overlay; irrelevant otherwise.
# DOMAIN=hisse.example.com
# Contact address for Let's Encrypt expiry/problem notices (optional).
# ACME_EMAIL=admin@example.com
