# Copy to .env and fill in secrets. Defaults below match docker-compose.yml
# and src/core/config.py — `docker compose up` works out of the box with
# this file copied verbatim (empty AI keys just leave news headlines unlabelled).

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
TZ=Europe/Istanbul

# --- Database ---
# Used directly when running the API/worker outside Docker (.venv). Inside
# docker-compose.yml, app/worker/migrate override these to point at the
# "db" service host instead — see the DATABASE_URL(_SYNC) lines there.
DATABASE_URL=postgresql+asyncpg://hisse:hisse@localhost:5432/hisse_analizi
DATABASE_URL_SYNC=postgresql://hisse:hisse@localhost:5432/hisse_analizi
# Log every SQL statement — very noisy, debugging only.
DB_ECHO=false
# Read by docker-compose.yml to create the "db" container; keep in sync with
# the URLs above when changed.
POSTGRES_USER=hisse
POSTGRES_PASSWORD=hisse
POSTGRES_DB=hisse_analizi

# --- Worker polling ---
DEFAULT_POLL_INTERVAL_SECONDS=30
USER_AGENT=HisseAnalizi/1.0
WORKER_MAX_CONCURRENCY=5
WORKER_SINGLE_REPLICA=true
# Fits Docker's default 10s "stop" grace period.
WORKER_SHUTDOWN_TIMEOUT_SECONDS=8.0

# --- HTTP client (src/adapters/utils.py shared httpx client) ---
HTTP_CONNECT_TIMEOUT=15.0
HTTP_READ_TIMEOUT=30.0

# --- Upstream failure backoff (adapter polling loops and outbox retries) ---
BACKOFF_BASE_SECONDS=60
BACKOFF_MAX_SECONDS=900
BACKOFF_FACTOR=2
MAX_CONSECUTIVE_FAILURES=5

# --- Outbox / notifications ---
OUTBOX_BATCH_SIZE=10
# After this many failed attempts an outbox entry is marked status=failed.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=30
# Events older than this are not e-mailed (avoids spamming after backfills/outages).
NOTIFICATION_MAX_EVENT_AGE_HOURS=48

# --- Admin & security ---
# Admin API key — required in production, optional in dev (all admin calls
# bypass auth in dev if unset)
ADMIN_API_KEY=
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Reverse-proxy / load-balancer addresses trusted to set X-Forwarded-* headers
# for client-IP-based rate limiting (comma-separated IPs or CIDR ranges).
# Defaults cover loopback + private RFC1918 ranges (Docker bridge networks).
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- Rate limiting ---
# The dashboard UI makes ~20 API calls per page load; 300/minute is the
# site-wide default per client IP (see TRUSTED_PROXIES above).
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_ADMIN=20/minute

# --- AI / LLM — haber duygu siniflandirmasi; secili saglayicinin anahtari bos
# birakilirsa haberler etiketsiz saklanir, sistemin geri kalani calisir. ---
# Saglayici: "gemini" (Google AI Studio, varsayilan) | "anthropic" (Claude)
AI_PROVIDER=gemini
# Google AI Studio anahtari: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Anthropic (alternatif saglayici)
ANTHROPIC_API_KEY=
AI_CLASSIFIER_MODEL=claude-haiku-4-5
AI_DAILY_BUDGET_USD=5.0

# --- Haber toplama (Faz 2) — Google News RSS, 15 dk'da bir BIST 100 taramasi ---
NEWS_POLL_ENABLED=true
NEWS_POLL_INTERVAL_SECONDS=900
NEWS_FETCH_CONCURRENCY=4
# Yeni haberleri LLM ile duygu/etki etiketleme (anahtar yoksa otomatik atlanir)
AI_NEWS_CLASSIFY_ENABLED=true

# --- SMTP (optional — dry-run if not configured) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Port 465 -> implicit TLS, any other port -> STARTTLS.
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30.0
ENABLE_REAL_EMAIL=false

# --- Macro store (data-infra WS4) — TCMB rates/corridor, TUIK CPI/PPI, FX bulletins ---
# Store-first freshness windows; "age" = time since last provider check, not the
# observation's own date (a rate decision can be months old and still be current).
MACRO_MAX_AGE_RATES_HOURS=6.0
MACRO_MAX_AGE_INFLATION_HOURS=12.0
# 15:00-16:30 Istanbul (around the ~15:30 TCMB bulletin) vs the rest of the day.
MACRO_MAX_AGE_FX_PEAK_HOURS=1.0
MACRO_MAX_AGE_FX_OFFPEAK_HOURS=6.0
MACRO_FX_BACKFILL_DAYS=730
MACRO_FX_ARCHIVE_CONCURRENCY=6
# Optional EVDS3 key (https://evds3.tcmb.gov.tr -> BENIM SAYFAM). Empty disables
# evds.* series; tcmb.*/tuik.* series work without it.
MACRO_EVDS_API_KEY=

# --- Production front proxy (Caddy, docker-compose.prod.yml only) ---
# Public hostname Caddy requests a Let's Encrypt certificate for. Required
# when using the prod overlay; irrelevant otherwise.
# DOMAIN=hisse.example.com
# Contact address for Let's Encrypt expiry/problem notices (optional).
# ACME_EMAIL=admin@example.com

# --- Fundamentals store (data-infra WS3) ---
# KAP financial summary + İş Yatırım MaliTablo → financial_statements / financial_facts /
# financial_ratios. API reads are store-first: statements are served from PostgreSQL while
# younger than FUNDAMENTALS_MAX_AGE_STATEMENTS_HOURS, otherwise fetched live and stored; when
# the provider fails the stored copy is returned with meta.stale=true.
FUNDAMENTALS_MAX_AGE_STATEMENTS_HOURS=72
FUNDAMENTALS_MAX_AGE_RATIOS_HOURS=36
# Worker (src/workers/fundamentals_worker.py): per-company statement refresh cadence.
FUNDAMENTALS_REFRESH_CORE_HOURS=72
FUNDAMENTALS_REFRESH_UNIVERSE_HOURS=336
FUNDAMENTALS_RETRY_FAILED_HOURS=6
FUNDAMENTALS_BATCH_SIZE=12
FUNDAMENTALS_LOOP_INTERVAL_SECONDS=600
# Daily ratio recompute after this Istanbul hour (uses the day's final quotes).
FUNDAMENTALS_RATIOS_HOUR=19
# kap.org.tr blocks an IP for ~6 minutes after ~100 requests in 2 minutes: KAP pages are
# fetched one at a time, at least this many seconds apart, with a cool-down after a block.
FUNDAMENTALS_KAP_MIN_INTERVAL_SECONDS=3
FUNDAMENTALS_KAP_BLOCK_SECONDS=420
FUNDAMENTALS_ISY_CONCURRENCY=3
# An API request waits at most this long for a live refresh before serving the stale copy.
FUNDAMENTALS_LIVE_TIMEOUT_SECONDS=30
# Quotes-table prices older than this are not used for valuation ratios (TradingView scan instead).
FUNDAMENTALS_QUOTE_MAX_AGE_HOURS=96
FUNDAMENTALS_WORKER_ENABLED=true

# --- Reference data (data-infra WS1) ---
# Company universe (TradingView scanner + Borsa İstanbul index file + KAP directories) is
# synced daily into companies / market_indices / index_memberships; XU100 members are
# tracking_tier=core. Per-company reference datasets (dividends, capital increases, holders,
# analyst targets, KAP expected disclosures) are refreshed for core companies by
# src/workers/reference_worker.py and served store-first by /fundamentals/{ticker}/*.
REFERENCE_WORKER_ENABLED=true
# Daily universe.sync (Europe/Istanbul) and the "sync on start" threshold.
REFERENCE_UNIVERSE_SYNC_TIME=07:30
REFERENCE_UNIVERSE_STALE_HOURS=20
# Comma-separated tickers kept core in addition to the XU100 constituents.
REFERENCE_EXTRA_CORE_TICKERS=
# reference.company cadence: each core company at most once per N days, spread over the day
# (REFERENCE_BATCH_SIZE companies every REFERENCE_TICK_SECONDS, REFERENCE_CONCURRENCY at a time).
REFERENCE_COMPANY_REFRESH_DAYS=7
REFERENCE_RETRY_FAILED_HOURS=6
REFERENCE_TICK_SECONDS=900
REFERENCE_BATCH_SIZE=2
REFERENCE_CONCURRENCY=2
REFERENCE_COMPANY_DELAY_SECONDS=5
REFERENCE_ONCE_MAX_COMPANIES=10
# API freshness of stored reference data (older copies are refreshed live; stale on failure).
REFERENCE_MAX_AGE_HOURS=24
REFERENCE_HOLDERS_MAX_AGE_HOURS=168
# ISINs cross-checked against ISIN Türkiye (MKK) on every universe.sync (data_quality_checks).
REFERENCE_ISIN_SAMPLE_SIZE=10

# --- Market store (data-infra WS2) ---
# src/workers/market_worker.py fills quotes + price_bars; /market/*, /technical/*, /prices*,
# /fundamentals/{ticker}/fast-info read them store-first (src/services/market_service.py).
# false = live-only reads (pre data-platform behaviour); reads also fall back to live when the
# database is slower than MARKET_STORE_TIMEOUT_SECONDS.
MARKET_STORE_ENABLED=true
MARKET_STORE_TIMEOUT_SECONDS=3.0
# Quotes: one TradingView scanner request for the whole universe every N seconds inside the
# Istanbul window (weekdays), plus one run after the session is final (18:30). The free feed
# is 15 minutes delayed (quotes.delay_seconds=900).
MARKET_QUOTE_INTERVAL_SECONDS=60
MARKET_SESSION_OPEN=09:55
MARKET_SESSION_CLOSE=18:20
# Store-first freshness inside the session (after the close a post-final copy stays fresh).
MARKET_QUOTE_MAX_AGE_SECONDS=180
MARKET_BAR_MAX_AGE_SECONDS=300
# İş Yatırım OneEndeks requests per quote cycle for symbols the scanner lacks (e.g. XUSIN).
MARKET_ISY_FALLBACK_MAX_SYMBOLS=60
# Final daily bars (+ continuity/split check) and the İş Yatırım reconciliation (turnover,
# VWAP, close cross-check → data_quality_checks), Europe/Istanbul, weekdays.
MARKET_DAILY_BARS_AFTER=18:40
MARKET_RECONCILE_AFTER=20:00
MARKET_RECONCILE_DAYS=10
MARKET_RECONCILE_CONCURRENCY=2
# History backfill (TradingView websocket, split-adjusted, ~3 s per symbol): years kept for
# tracking_tier=core (+ main indices) and for the rest of the universe; one pass handles at
# most MARKET_BACKFILL_BATCH_SIZE symbols / MARKET_BACKFILL_MAX_SECONDS.
MARKET_BACKFILL_ENABLED=true
MARKET_BACKFILL_CORE_YEARS=5
MARKET_BACKFILL_UNIVERSE_YEARS=2
MARKET_BACKFILL_BATCH_SIZE=40
MARKET_BACKFILL_MAX_SECONDS=300
MARKET_BACKFILL_DELAY_SECONDS=1.0
MARKET_BACKFILL_IDLE_SECONDS=3600

# --- Platform quality (data-infra WS6) ---
# Last-good-copy store (data_snapshots), cross-source/freshness checks (data_quality_checks,
# src/services/quality_service.py), /data/status and /data/quality. Times are Europe/Istanbul.
QUALITY_WORKER_ENABLED=true
# quality.daily schedule + "run on start if the last good run is older than this".
QUALITY_DAILY_RUN_TIME=19:30
QUALITY_STALE_RUN_HOURS=24
# Retention / housekeeping (run at the end of every quality.daily cycle).
QUALITY_RETENTION_DAYS=90
QUALITY_INGESTION_RETENTION_DAYS=30
QUALITY_SNAPSHOT_PURGE_GRACE_DAYS=14
# POST /admin/data/refresh time budget.
QUALITY_REFRESH_TIMEOUT_SECONDS=120
# Freshness thresholds (see docs/data-platform.md §7 for the full catalogue).
QUALITY_QUOTES_SESSION_WARN_MINUTES=20
QUALITY_QUOTES_SESSION_FAIL_MINUTES=60
QUALITY_QUOTES_OFFSESSION_WARN_HOURS=48
QUALITY_QUOTES_OFFSESSION_FAIL_HOURS=120
QUALITY_FUNDAMENTALS_COVERAGE_WARN_PCT=80
QUALITY_FUNDAMENTALS_COVERAGE_FAIL_PCT=50
QUALITY_MACRO_CADENCE_DEFAULT_DAYS=45
QUALITY_INGESTION_DEFAULT_INTERVAL_HOURS=24
QUALITY_INTEGRITY_FAIL_THRESHOLD=5
QUALITY_STALE_ACTIVE_COMPANY_DAYS=3
# cross_source.price_isyatirim: TradingView (price_bars) vs İş Yatırım HGDG_KAPANIS.
QUALITY_PRICE_CROSSCHECK_SYMBOLS=5
QUALITY_PRICE_CROSSCHECK_BARS=10
QUALITY_PRICE_CROSSCHECK_WARN_PCT=2.0
QUALITY_PRICE_CROSSCHECK_FAIL_PCT=5.0
QUALITY_PRICE_CROSSCHECK_TIMEOUT_SECONDS=20
