{
  "name": "hisse-analizi-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Hisse Analizi için iOS native uygulama temeli (Expo Router / React Native)",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"lib/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~53.0.0",
    "expo-clipboard": "~7.1.0",
    "expo-linking": "~7.1.0",
    "expo-router": "~5.0.0",
    "expo-splash-screen": "~0.30.0",
    "expo-status-bar": "~2.2.0",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "~19.0.10",
    "typescript": "^5.8.3"
  }
}
