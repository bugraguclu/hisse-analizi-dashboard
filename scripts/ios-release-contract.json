{
  "schemaVersion": 1,
  "appName": "Hisse Analizi",
  "bundleIdentifierPattern": "^[a-zA-Z0-9-]+(\\.[a-zA-Z0-9-]+){2,}$",
  "requiredUrlSchemes": [
    "hisseanalizi"
  ],
  "requireAssociatedDomains": true,
  "requireCompleteDataProtection": true,
  "requireDarkModeAutomatic": true,
  "requireNoArbitraryLoads": true,
  "requireNoLocalNetworking": true,
  "requireNonExemptEncryptionFalse": true,
  "requirePrivacyManifest": true,
  "requireNotificationConfig": true
}
